<style is:global>
  /* A0 only, and only on this poster. This sheet carries nine cells in six
     rows where the others carry seven in five, so its gutters and cell
     paddings alone add a row's worth of height and the TL;DR band landed
     exactly on the sheet edge: 0 mm bottom margin, nothing visibly cut, and a
     trim at the print shop would have taken the border off. Buying the margin
     back from the gutters costs no copy and no numbers; the alternative was
     cutting three captions. The landscape sheet has height to spare and keeps
     the house values. This rule is scoped to this poster because it ships in
     this sheet's own global block.

     If a future poster hits the same wall, prefer this over cutting content,
     and never go below 6 mm: at 5 mm the cells stop reading as separate
     panels from across a room. */
  body[data-format='portrait'] .poster-canvas {
    gap: 6mm 8mm;
  }

  body[data-format='portrait'] .poster-cell {
    padding: 6mm 10mm;
  }

  /* Paper palette (arXiv:2608.19303 LaTeX definecolor): ocmain #206945
     (advisory green), ocwarn #B0392E (failure red), ocflag #9E6C14 (flag
     amber), ocink #272E34, ocmuted #696F74. */
  :root {
    --color-oc-main: 32 105 68;
    --color-oc-warn: 176 57 46;
    --color-oc-flag: 158 108 20;
    --color-oc-ink: 39 46 52;
    --color-oc-muted: 105 111 116;
  }

  /* Eight cells, two of them figure-heavy, do not fit the three-band shape the
     shared landscape rule assumes: the takeaway takes a full-width band of its
     own between the supporting checks and the TL;DR. The two figure bands are
     near-equal here because the ablation cell in the lower band carries two
     charts, so the default 1.12 / 0.88 split would clip it. */
  body[data-format='landscape'] .poster-canvas {
    grid-template-rows: auto minmax(0, 1.04fr) minmax(0, 0.96fr) auto auto;
  }
</style>

