<style>
  .k-seam {
    color: rgb(var(--seam-speech));
    font-weight: 600;
  }

  .gap-above {
    margin-top: 4mm;
  }

  /* A0 gives cell 1 the full sheet width, so the prose sits beside the wide
     overview figure; the landscape sheet gives it one narrow column, where the
     same split would squeeze both, so they stack. */
  /* Stacked in both formats. Side by side, the prose column runs out well
     before the 2.3:1 figure does, leaving the whole lower-left of the cell
     empty — the figure's aspect sets the cell height, and no prose width
     fixes that. Prose above, figure below, so both use the full width. */
  .problem-split {
    display: flex;
    flex-direction: column;
    gap: 7mm;
  }

  .problem-text {
    flex: 0 0 auto;
  }

  .problem-split .poster-figure {
    min-width: 0;
  }

  /* On A0 this cell spans all 12 columns, where a full-width figure would
     tower over the prose it illustrates; 74% keeps it dominant without
     becoming a band of its own. Landscape keeps the default 100% — its cell
     is 4 columns, so the figure needs every millimetre. */
  :global(body[data-format='portrait']) .seam-figure {
    --fig-w: 69%;
  }

  :global(body[data-format='landscape']) .problem-split {
    flex-direction: column;
    gap: 5mm;
    flex: 1;
    min-height: 0;
  }

  :global(body[data-format='landscape']) .problem-text {
    flex: 0 0 auto;
  }

  /* The list is now short enough to leave slack above the caption, so it takes
     the cell's spare height and distributes it between rows rather than
     pooling it as one gap. Harmless when there is no slack: the rows simply
     sit at their natural spacing. */
  .cond-list {
    margin-bottom: 4mm;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }

  /* Name and gloss share a row rather than stacking, which halves the cell's
     height; a full-width rule separates each condition from the next. */
  .cond-list > div {
    display: grid;
    grid-template-columns: 2mm 30% 1fr;
    gap: 0 3.5mm;
    align-items: baseline;
    padding: 2.4mm 0;
    border-top: 0.4mm solid rgb(var(--color-border-paper));
  }

  .cond-list > div:last-child {
    border-bottom: 0.4mm solid rgb(var(--color-border-paper));
  }

  .cond-swatch {
    display: block;
    width: 2mm;
    height: 1em;
    background-color: var(--cond-c);
    transform: translateY(0.15em);
  }

  .cond-list dt {
    font-weight: 500;
    color: var(--cond-c);
  }

  .cond-list dd {
    margin: 0;
    color: rgb(var(--color-ink-muted));
  }

  .board-figure {
    --fig-w: 100%;
  }

  .syntax-figure {
    --fig-w: 100%;
  }
</style>
