  }

  /* Landscape only: seven glosses in a three-column cell at the 1.4 type scale.
     Leading is the one place left to take height from once the wording is as
     short as it can be without dropping a dimension of the design. */
  :global(body[data-format='landscape']) .axis-list dd,
  :global(body[data-format='landscape']) .axis-list dt {
    line-height: 1.3;
  }

