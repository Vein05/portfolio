  }

  .axis-list > div {
    display: grid;
    /* The term column is sized in em, not mm, so it holds the longest term
       ("Destructive") at both sheets' type scales. The terms and their
       glosses share one list, so the cell's height goes into row spacing
       rather than into prose written to fill the slack. */
    grid-template-columns: 4.9em 1fr;
    gap: 0 1.1em;
    padding: 2.4mm 0;
    border-top: 0.4mm solid rgb(var(--lapse-box));
  }

  .axis-list > div:first-child {
