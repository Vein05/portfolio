  /* The schematic is 1.7:1 and the prose column would run out well before it,
     so they stack rather than sitting side by side. */
  .lapse-schematic {
    width: 100%;
  }

  /* Cell 3 carries two panels. A0 gives the cell the full sheet width, so they
     sit side by side; the landscape sheet gives it one column of five, where
     the pair would squeeze both, so `stacked` puts them in one column. */
  .result-split {
    display: grid;
    grid-template-columns: 0.88fr 1.12fr;
