      .prep details > ul li { margin: 0.25rem 0; }
      .prep a { color: rgb(var(--color-ink-blue)); }
      .prep mark { background: rgba(250, 204, 21, 0.38); color: inherit; padding: 0 2px; }
      .prep .must { border: 1px solid rgb(var(--color-border-paper)); border-left: 3px solid rgba(234, 179, 8, 0.9); padding: 0.75rem 1rem 0.25rem; }
      .prep a:hover { text-decoration: underline; }
      .prep .row { display: grid; grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); gap: 0.25rem 1.25rem; padding: 0.6rem 0; border-top: 1px solid rgb(var(--color-border-paper)); }
      .prep .row > :first-child { font-weight: 500; }
      .prep .paper { border-top: 1px solid rgb(var(--color-border-paper)); padding: 0.9rem 0; }
      .prep .label { font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: rgb(var(--color-ink-muted)); margin-top: 0.6rem; }
      .prep .compare { width: 100%; border-collapse: collapse; font-size: 14.5px; }
      .prep .compare th, .prep .compare td { text-align: left; vertical-align: top; padding: 0.5rem 0.6rem 0.5rem 0; border-top: 1px solid rgb(var(--color-border-paper)); }
      .prep .compare thead th { font-weight: 500; color: rgb(var(--color-ink-blue)); }
      .prep .compare tbody th { font-weight: 500; }
      .prep .compare-wrap { overflow-x: auto; }
      .prep ol.asks { list-style: decimal; margin-left: 1.45rem; padding-left: 1rem; }
      .prep ol.asks li { margin: 0.5rem 0; }
      @media (max-width: 560px) { .prep .row { grid-template-columns: minmax(0, 1fr); } .prep .compare { min-width: 34rem; } }
      @media print { .prep .no-print { display: none; } }
    </style>
  </head>
  <body>
    <div class="prep min-h-screen bg-paper-light text-ink-dark">
      <main class="mx-auto max-w-[46rem] px-4 py-10 text-[16px] leading-relaxed sm:px-6">
        <header class="mb-8">
          <p class="kicker">Unlisted</p>
          <h1 class="mt-1 text-3xl font-semibold">Microsoft Research interview</h1>
          <p class="mt-3">Who is interviewing you, what they work on, where your work meets theirs, and what to ask. For deep questions on your own papers, use the <a href="/prep-e3d21522/">general prep page</a>.</p>
          <p class="mt-3 text-sm text-ink-muted">Facts about the interviewers come from their profiles and papers, checked on November 16, 2026. Anything marked as a guess is a guess.</p>
        </header>

        <nav class="no-print mb-8 flex flex-wrap items-center gap-x-4 gap-y-1 border-y border-border-paper py-3 text-sm" aria-label="Sections">
          {nav.map(([id, title]) => <a href={`#${id}`}>{title}</a>)}
          <button id="toggle-all" type="button" class="ml-auto border border-border-paper px-3 py-1 text-ink-dark">Open all</button>
        </nav>

        <section id="must" class="must mb-10 scroll-mt-4">
          <p class="kicker">If you read nothing else</p>
          <h2 class="mb-2 mt-1 text-xl font-semibold">Must know</h2>
          <p class="mb-2 text-sm text-ink-muted">Highlighted text across the page marks the facts to know by heart.</p>
          {mustKnow.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
        </section>

        <section class="mb-10">
          <p class="kicker">Logistics</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">The call</h2>
          {logistics.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
        </section>

        <section id="plan" class="mb-10 scroll-mt-4">
          <p class="kicker">Start here</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">The plan</h2>
          {plan.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
          <h3 class="mb-2 mt-6 text-base font-semibold text-ink-blue">How 30 minutes might go</h3>
          <p class="mb-2 text-sm text-ink-muted">A guess, not from a report.</p>
          {shape.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
          <h3 class="mb-2 mt-6 text-base font-semibold text-ink-blue">Asked in a past intern's interview</h3>
          <p class="mb-2 text-sm text-ink-muted">From a 2022 intern's blog (one 40 to 45 minute panel). Either of them may ask these.</p>
          {common.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <ul>{item.points.map((point) => <li>{hl(point).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</li>)}</ul>
            </details>
          ))}
        </section>

        <section id="barke" class="mb-10 scroll-mt-4">
          <p class="kicker">Interviewer, Redmond</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Shraddha Barke</h2>
          {barkeWho.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">Her papers that matter for you</h3>
          {barkePapers.map((p) => (
            <div class="paper">
              <a href={p.href} {...external} class="font-medium">{p.title}</a>
              <p class="text-sm text-ink-muted">{p.role}</p>
              <p class="label">What it does</p>
              <p>{hl(p.what).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</p>
              <p class="label">Why it matters to you</p>
              <p>{hl(p.you).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</p>
            </div>
          ))}

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">Her other work, in one line each</h3>
          {barkeOther.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
        </section>

        <section id="compare" class="mb-10 scroll-mt-4">
          <p class="kicker">Most likely question</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Your work vs hers</h2>
          <p class="mb-3">All three catch agent mistakes with rules. They differ in when they look and what they look at.</p>
          <div class="compare-wrap">
            <table class="compare">
              <thead><tr><th></th><th>Outcome Monitors (yours)</th><th>AgentRx</th><th>Symbolic Constraint Agents</th></tr></thead>
              <tbody>{compare.map(([label, a, b, c]) => <tr><th scope="row">{label}</th><td>{a}</td><td>{b}</td><td>{c}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="mt-3 text-sm text-ink-muted">Symbolic Constraint Agents' warning adds the broken rule to the agent's context, for example "LOGIN must use the id from an earlier REGISTER". It has no separate list of recovery tools, though a rule can name the tool to call. Its limitations section says call rules cannot catch failures hidden in the environment's state. Those are the failures a check on results is for.</p>
          <h3 class="mb-2 mt-6 text-base font-semibold text-ink-blue">The two-sentence answer</h3>
          <p>AgentRx explains a failed run afterwards, and Symbolic Constraint Agents checks a call before it runs. Outcome Monitors checks what a tool sent back, during the run, and tells the agent which tools can repair it.</p>

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">How your rules are mined</h3>
          <p class="mb-3">She will want to know where the rules come from and whether a model wrote them. Your answer: a program mines them, and no model is involved until the agent reads the receipt.</p>
          {mining.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">What she might ask</h3>
          <p class="mb-2 text-sm text-ink-muted">Guesses based on her papers. Say your answer aloud, then open the points.</p>
          {barkeAsk.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <ul>{item.points.map((point) => <li>{hl(point).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</li>)}</ul>
            </details>
          ))}

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">A specific project to offer</h3>
          <p class="mb-3">It starts from a gap her own paper names, uses her benchmark setting, and leaves the choice to her. Say it in your own words:</p>
          <p class="mb-3 border-l-2 border-ink-blue pl-3">{pitchSay}</p>
          {pitch.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">What to ask her</h3>
          <p class="mb-2 text-sm text-ink-muted">Checked against her papers on November 16. Each one starts from something the paper leaves open. Pick one or two.</p>
          <ol class="asks">{barkeQuestions.map((a) => <li>{a.q}<span class="mt-1 block text-sm text-ink-muted">Why: {a.why}</span></li>)}</ol>
          <p class="label mt-5">Already answered in her papers. Do not ask, but know the answer</p>
          {barkeAnswered.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">Read before Wednesday</h3>
          {barkeRead.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
        </section>

        <section id="since" class="mb-10 scroll-mt-4">
          <p class="kicker">Your progress, for her</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Since Outcome Monitors</h2>
          <p class="mb-3">Tell her the work did not stop at one paper. Say this in your own words, then go to whichever part she asks about:</p>
          <p class="mb-3 border-l-2 border-ink-blue pl-3">{sinceLine}</p>
          <p class="label mt-5">The thread, one line each</p>
          {bridge.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">Recovery gap: what makes an agent recover</h3>
          {recovery.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
          <p class="label mt-5">What you found</p>
          {recoveryFindings.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
          <p class="label mt-5">Where it meets her work</p>
          <ul class="ml-5 list-disc space-y-1">{recoveryHer.map((point) => <li>{hl(point).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</li>)}</ul>
          <details class="mt-4">
            <summary>Be careful with</summary>
            <ul>{recoveryCareful.map((point) => <li>{hl(point).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</li>)}</ul>
          </details>

          <h3 class="mb-2 mt-10 text-base font-semibold text-ink-blue">Gemma 4 paper: who checks a coding agent's fix</h3>
          {gemma.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
          <p class="label mt-5">What you found</p>
          {gemmaFindings.map(([label, text]) => <div class="row"><span>{label}</span><span>{label === 'The example' ? <>{text.replace(' Details on the general prep page.', '')}{' '}<a href="/prep-e3d21522/#matplotlib">Details on the general prep page</a>.</> : hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
          <p class="label mt-5">Where it meets her work</p>
          <ul class="ml-5 list-disc space-y-1">{gemmaHer.map((point) => <li>{hl(point).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</li>)}</ul>
          <details class="mt-4">
            <summary>Be careful with</summary>
            <ul>{gemmaCareful.map((point) => <li>{hl(point).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</li>)}</ul>
          </details>
        </section>

        <section id="mobius" class="mb-10 scroll-mt-4">
          <p class="kicker">Interviewer, New England</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Markus Mobius</h2>
          {mobiusWho.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">Why an economist?</h3>
          <p class="mb-2 text-sm text-ink-muted">A guess. No Microsoft source says how interviewers are paired.</p>
          <p>His recent papers use language models as measuring tools and test whether results hold up. Your papers ask the same question about benchmarks. He may also be there to test how you reason: what you claim, what would prove you wrong, and whether you can say it without jargon.</p>

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">His papers that matter for you</h3>
          {mobiusPapers.map((p) => (
            <div class="paper">
              <a href={p.href} {...external} class="font-medium">{p.title}</a>
              <p class="text-sm text-ink-muted">{p.role}</p>
              <p class="label">What it does</p>
              <p>{hl(p.what).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</p>
              <p class="label">Why it matters to you</p>
              <p>{hl(p.you).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</p>
            </div>
          ))}

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">How the payment paper decides who gets credit</h3>
          <p class="mb-3">When many outlets carry the same fact, someone has to decide who gets paid. The paper does not pick a correct answer. It lays out three rules and measures how much the payout moves.</p>
          {payRules.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
          <p class="mt-3 text-sm text-ink-muted">Source: the paper's text, sections 3 to 5, Appendix B and the limitations.</p>

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">What Magentic Marketplace found</h3>
          {marketResults.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
          <p class="mt-3 text-sm text-ink-muted">Source: arXiv 2510.25779, version 1, sections 4 and 5.</p>

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">What he might ask</h3>
          <p class="mb-2 text-sm text-ink-muted">Guesses based on his field.</p>
          {mobiusAsk.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <ul>{item.points.map((point) => <li>{hl(point).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</li>)}</ul>
            </details>
          ))}

          <h3 id="summer" class="mb-2 mt-8 scroll-mt-4 text-base font-semibold text-ink-blue">If he asks what you would work on this summer</h3>
          <p class="mb-3 text-sm text-ink-muted">Built from your memory paper and his marketplace paper. Checked against his paper's text on November 16.</p>
          <p class="label">The question</p>
          <p class="mb-3"><mark>{summerQ}</mark></p>
          <p class="label">Say it in about 45 seconds</p>
          <p class="mb-3 border-l-2 border-ink-blue pl-3">{summerSay}</p>
          <p class="label">The same idea in both papers</p>
          <div class="compare-wrap">
            <table class="compare">
              <thead><tr><th></th><th>Your memory paper</th><th>His marketplace</th></tr></thead>
              <tbody>{summerMap.map(([label, a, b]) => <tr><th scope="row">{label}</th><td>{a}</td><td>{b}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="label mt-5">Why it is interesting to him</p>
          <ul class="ml-5 list-disc space-y-1">{summerWhy.map((point) => <li>{hl(point).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}.</li>)}</ul>
          <p class="label mt-5">Twelve weeks</p>
          {summerPlan.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
          <p class="label mt-5">What you would report, either way</p>
          {summerResults.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
          <p class="label mt-5">What you do not know, and should say</p>
          <ul class="ml-5 list-disc space-y-1">{summerLimits.map((point) => <li>{point}.</li>)}</ul>

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">What to ask him</h3>
          <p class="mb-2 text-sm text-ink-muted">Checked against his papers on November 16. Each one starts from something the paper leaves open. Pick one or two. The first is the closest to your work.</p>
          <ol class="asks">{mobiusQuestions.map((a) => <li>{a.q}<span class="mt-1 block text-sm text-ink-muted">Why: {a.why}</span></li>)}</ol>

          <h3 class="mb-2 mt-8 text-base font-semibold text-ink-blue">Read before Wednesday</h3>
          {mobiusRead.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
        </section>

        <section id="plain" class="mb-10 scroll-mt-4">
          <p class="kicker">For a non-specialist</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Plain versions of your work</h2>
          <p class="mb-3 text-sm text-ink-muted">About 30 seconds each. Say them aloud.</p>
          {plainVersions.map(([label, text]) => <div class="row"><span>{label}</span><span>{hl(text).map((part, i) => i % 2 ? <mark>{part}</mark> : part)}</span></div>)}
        </section>

        <section id="day" class="mb-10 scroll-mt-4">
          <p class="kicker">Checklist</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Day of</h2>
          <ul class="ml-5 list-disc space-y-1">{day.map((d) => <li>{d}</li>)}</ul>
        </section>

        <footer class="border-t border-border-paper pt-4 text-sm text-ink-muted">
          <p class="kicker mb-2">Sources</p>
          <ul class="space-y-1">{sources.map(([label, href]) => <li><a href={href} {...external}>{label}</a></li>)}</ul>
          <p class="mt-2">Full notes with every paper: research/reu/msr-interview/.</p>
        </footer>
      </main>
    </div>
    <script is:inline>
      const toggle = document.getElementById('toggle-all');
      toggle.addEventListener('click', () => {
        const open = toggle.textContent === 'Open all';
        document.querySelectorAll('.prep details').forEach((d) => { d.open = open; });
        toggle.textContent = open ? 'Close all' : 'Open all';
      });
    </script>
  </body>
</html>
