---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>Interview prep</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('portfolio-theme');
        document.documentElement.dataset.theme = stored === 'dim' ? 'dim' : 'daylight';
      } catch {
        document.documentElement.dataset.theme = 'daylight';
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      .prep { font-family: 'IBM Plex Sans', sans-serif; }
      .prep .kicker { font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(var(--color-ink-muted)); }
      .prep summary { cursor: pointer; list-style: none; display: flex; gap: 0.6rem; font-weight: 500; padding: 0.7rem 0; }
      .prep summary::-webkit-details-marker { display: none; }
      .prep summary::before { content: '+'; font-family: 'IBM Plex Mono', monospace; color: rgb(var(--color-ink-blue)); flex: none; width: 0.8rem; }
      .prep details[open] > summary::before { content: '\2212'; }
      .prep details { border-top: 1px solid rgb(var(--color-border-paper)); }
      .prep details > ul { list-style: disc; margin: 0 0 0.9rem 1.45rem; padding-left: 1rem; color: rgb(var(--color-ink-dark)); }
      .prep details > ul li { margin: 0.25rem 0; }
      .prep a { color: rgb(var(--color-ink-blue)); }
      .prep a:hover { text-decoration: underline; }
      .prep .row { display: grid; grid-template-columns: minmax(0, 13rem) minmax(0, 1fr); gap: 0.25rem 1.25rem; padding: 0.6rem 0; border-top: 1px solid rgb(var(--color-border-paper)); }
      .prep .row > :first-child { font-weight: 500; }
      @media (max-width: 560px) { .prep .row { grid-template-columns: minmax(0, 1fr); } }
      @media print { .prep .no-print { display: none; } }
    </style>
  </head>
  <body>
    <div class="prep min-h-screen bg-paper-light text-ink-dark">
      <main class="mx-auto max-w-[46rem] px-4 py-10 text-[16px] leading-relaxed sm:px-6">
        <header class="mb-8">
          <p class="kicker">Unlisted</p>
          <h1 class="mt-1 text-3xl font-semibold">Research interview prep</h1>
          <p class="mt-3">Questions with short points, not scripted answers. Say each answer aloud, then open the points to see what you missed. Built for the Microsoft Research undergraduate internship, and most of it carries over to other research interviews.</p>
          <p class="mt-3 text-sm text-ink-muted">Questions come from interview reports and your own papers and notes. Items marked as a prediction or inference are guesses. Updated November 5, 2026.</p>
        </header>

        <nav class="no-print mb-8 flex flex-wrap items-center gap-x-4 gap-y-1 border-y border-border-paper py-3 text-sm" aria-label="Sections">
          {nav.map(([id, title]) => <a href={`#${id}`}>{title}</a>)}
          <button id="toggle-all" type="button" class="ml-auto border border-border-paper px-3 py-1 text-ink-dark">Open all</button>
        </nav>

        <section class="mb-10">
          <p class="kicker">What people report</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">What to expect</h2>
          <p class="mb-3 text-sm text-ink-muted">Self-reported and uneven. Microsoft does not describe the format or dates.</p>
          {expect.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
        </section>

        <section class="mb-10">
          <p class="kicker">A judgment call, not from a report</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">What transfers</h2>
          {transfers.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
        </section>

        {sections.map((section) => (
          <section id={section.id} class="mb-10 scroll-mt-4">
            <p class="kicker">{section.kicker}</p>
            <h2 class="mb-3 mt-1 text-xl font-semibold">{section.title}</h2>
            {section.note && <p class="mb-3 text-sm text-ink-muted">{section.note}</p>}
            {section.groups.map((group) => (
              <div class="mb-6">
                {group.title && <h3 class="mb-2 mt-5 text-base font-semibold text-ink-blue">{group.title}</h3>}
                {group.items.map((item) => (
                  <details>
                    <summary>{item.q}</summary>
                    <ul>{item.points.map((point) => <li>{point}</li>)}</ul>
                  </details>
                ))}
              </div>
            ))}
          </section>
        ))}

        <section id="design" class="mb-10 scroll-mt-4">
          <p class="kicker">About 10 minutes, said aloud</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Open-ended design</h2>
          <p class="mb-3 text-sm text-ink-muted">Only one such prompt is reported for this program. This structure is a working guess. If you blank, go back to choosing a metric.</p>
          {designSteps.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
          <h3 class="mb-2 mt-6 text-base font-semibold text-ink-blue">Practice prompts</h3>
          <ul class="ml-5 list-disc space-y-1">{designPrompts.map((prompt) => <li>{prompt}</li>)}</ul>
        </section>

        <section id="basics" class="mb-10 scroll-mt-4">
          <p class="kicker">Light review</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Basics</h2>
          {basics.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
        </section>

        <section id="labs" class="mb-10 scroll-mt-4">
          <p class="kicker">Inferred from each group's work</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">By lab</h2>
          <p class="mb-3 text-sm text-ink-muted">No report lists these. Read a paper before saying anything about it.</p>
          {labs.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
        </section>

        <section id="ask" class="mb-10 scroll-mt-4">
          <p class="kicker">End of the interview</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Ask them</h2>
          <ul class="ml-5 list-disc space-y-1">{askThem.map((question) => <li>{question}</li>)}</ul>
        </section>

        <section id="checks" class="mb-10 scroll-mt-4">
          <p class="kicker">Before the interview</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Still to check</h2>
          <ul class="ml-5 list-disc space-y-1">{checks.map((check) => <li>{check}</li>)}</ul>
        </section>

        <footer class="border-t border-border-paper pt-4 text-sm text-ink-muted">
          <p class="kicker mb-2">Sources</p>
          <ul class="space-y-1">{sources.map(([label, href]) => <li><a href={href} {...external}>{label}</a></li>)}</ul>
        </footer>
      </main>
    </div>
    <script is:inline>
      const toggle = document.getElementById('toggle-all');
      toggle.addEventListener('click', () => {
        const open = toggle.textContent === 'Open all';
        document.querySelectorAll('.prep details').forEach((d) => { d.open = open; });
        toggle.textContent = open ? 'Close all' : 'Open all';
      });
    </script>
  </body>
</html>
