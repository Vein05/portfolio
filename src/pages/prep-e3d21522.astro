  ['AI Interaction and Learning, MSR NYC', 'Multi-turn degradation, a correction at turn 30, multi-turn benchmarks without hidden choices. Read "LLMs Get Lost in Multi-Turn Conversation".'],
  ['FATE and STAC, MSR NYC', 'Concept, operationalization, validation. How to prefer one scoring target over another, beyond showing they disagree. Read Wallach\'s measurement papers.'],
  ['Asta, Ai2', 'Rubric and LLM-judge validity on their own benchmarks. Read AstaBench (arXiv 2510.21652) and "Deep Research, Shallow Evaluation" (arXiv 2603.06942).'],
  ['University labs and PhD interviews', 'Less coding, more "why this lab" and "what would you work on". Read the host\'s last two papers.'],
];

const askThem = [
  'What have past interns worked on, and what happened to that work?',
  'What would the scope of my role and contributions be?',
  'How is the project chosen: before I arrive, or together?',
  'What separates a great summer from a good one, in your view?',
  'What is your group\'s current biggest evaluation problem?',
];

const checks = [
  'Read AgentRx (arXiv 2602.02475). Skim Eureka (arXiv 2409.10566), since your statement names both',
  'Same Ranking: which LongMemEval-S retriever is missing from Figure 3, and why',
  'Same Ranking: which scorer produced the LongMemEval-S "answer F1" in Table 12, and what "strong" means there',
  'Same Ranking: how target mapping handles queries with several evidence turns',
  'Same Ranking: the source paper for each borrowed choice, and the kappa on the 36-case overlap',
  'Outcome Monitors: tasks and interval behind each main number',
  'SEAM: the multiple-comparison correction used',
  'CV: the 300+ event attendance figure is marked in your source as worth confirming',
  'Practice: mock interviews with your advisor or a grad student, then one open-ended prompt aloud each week',
];

const sources = [
  ['Intern blog, 2022', 'https://drshika.pages.dev/2022/03/03/Microsoft-Research-Internship'],
  ['Reddit, 2026 program thread', 'https://www.reddit.com/r/csMajors/comments/1ocjebv/microsoft_undergraduate_research_internship_2026/'],
  ['Reddit, earlier thread', 'https://www.reddit.com/r/csMajors/comments/1gl875n/microsoft_undergraduate_research_internship/'],
  ['Glassdoor, MSR research intern', 'https://www.glassdoor.com/Interview/Microsoft-Research-Intern-Interview-Questions-EI_IE1651.0,9_KO10,25.htm'],
  ['Alex Lu, internships at MSR', 'https://www.alexluresearch.com/resources/internships/'],
  ['MSR program FAQ', 'https://www.microsoft.com/en-us/research/academic-program/undergraduate-research-internship-computing/faq/'],
];

const matplotlibDiff = `-    elif align in ["left", "top"]:
+    elif align in ["right", "bottom"]:
         offsets = [d for h, d in hd_list]
-    elif align in ["right", "bottom"]:
+    elif align in ["left", "top"]:
         offsets = [height - h + d for h, d in hd_list]`;

const matplotlibPairings = [
  ['Original', 'Near edge: left, top. Far edge: right, bottom. Top and bottom are wrong.'],
  ['Gemma', 'Near edge: right, bottom. Far edge: left, top. Top and bottom are fixed, and left and right are now wrong.'],
  ['Reference fix', 'Near edge: left, bottom. Far edge: right, top. All four are right.'],
];

const matplotlibScores = [
  ['Gemma 4 31B', '100'],
  ['gpt-oss-20b', '10'],
  ['GLM-4.5', '20'],
  ['gpt-oss-120b', '22'],
  ['Kimi-K2', '90'],
  ['Qwen3-Coder', '95'],
  ['GLM-4.7-Flash', '100'],
  ['Llama-4-Maverick', '100'],
  ['Qwen3.5-9B', '100'],
];

const matplotlibTelling = [
  'A bug report says top and bottom are reversed',
  'Gemma swaps the code, so top and bottom now work, and left and right break',
  'Asked if the patch will pass, Gemma gives it 100 and talks only about top and bottom',
  'The hidden tests for left and right fail',
];

const matplotlibChallenges = [
  'One chosen case. Only 3 of the 8 outside judges scored it low, and the other 5 gave 90 or more',
  'GLM-4.5\'s 20 is not stable. With the reproduction script removed from the patch, GLM-4.5 scores it 95 and Gemma still scores it 100',
  'It does not show that Gemma recognized its own patch. Gemma 4 12B and 26B-A4B also scored it 100',
  'The shell result here is the exception. Gemma still gave 100 on 80% of the 51 patches in that test',
  'The repository-test repair does not help here, since no existing test breaks',
];

const nav = [['who', 'Who is asking'], ['matplotlib', 'The matplotlib example'], ...sections.map((s) => [s.id, s.title]), ['design', 'Open-ended design'], ['basics', 'Basics'], ['labs', 'By lab'], ['ask', 'Ask them'], ['checks', 'Still to check']];
const external = { target: '_blank', rel: 'noopener noreferrer' };
const linkParts = (text: string) => text.split(/\{\{|\}\}/);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>Interview prep</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('portfolio-theme');
        document.documentElement.dataset.theme = stored === 'dim' ? 'dim' : 'daylight';
      } catch {
        document.documentElement.dataset.theme = 'daylight';
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      .prep { font-family: 'IBM Plex Sans', sans-serif; }
      .prep .kicker { font-family: 'IBM Plex Mono', monospace; font-size: 11.5px; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(var(--color-ink-muted)); }
      .prep summary { cursor: pointer; list-style: none; display: flex; gap: 0.6rem; font-weight: 500; padding: 0.7rem 0; }
      .prep summary::-webkit-details-marker { display: none; }
      .prep summary::before { content: '+'; font-family: 'IBM Plex Mono', monospace; color: rgb(var(--color-ink-blue)); flex: none; width: 0.8rem; }
      .prep details[open] > summary::before { content: '\2212'; }
      .prep details { border-top: 1px solid rgb(var(--color-border-paper)); }
      .prep details > ul { list-style: disc; margin: 0 0 0.9rem 1.45rem; padding-left: 1rem; color: rgb(var(--color-ink-dark)); }
      .prep details > ul li { margin: 0.25rem 0; }
      .prep a { color: rgb(var(--color-ink-blue)); }
      .prep a:hover { text-decoration: underline; }
      .prep .row { display: grid; grid-template-columns: minmax(0, 13rem) minmax(0, 1fr); gap: 0.25rem 1.25rem; padding: 0.6rem 0; border-top: 1px solid rgb(var(--color-border-paper)); }
      .prep .row > :first-child { font-weight: 500; }
      .prep code { font-family: 'IBM Plex Mono', monospace; font-size: 0.88em; }
      .prep pre { font-family: 'IBM Plex Mono', monospace; font-size: 12px; line-height: 1.55; overflow-x: auto; padding: 0.75rem; border: 1px solid rgb(var(--color-border-paper)); }
      .prep .scores { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 1.25rem; max-width: 20rem; }
      .prep .scores > span { padding: 0.3rem 0; border-top: 1px solid rgb(var(--color-border-paper)); }
      .prep .scores > span:nth-child(even) { font-family: 'IBM Plex Mono', monospace; text-align: right; }
      @media (max-width: 560px) { .prep .row { grid-template-columns: minmax(0, 1fr); } }
      @media print { .prep .no-print { display: none; } }
    </style>
  </head>
  <body>
    <div class="prep min-h-screen bg-paper-light text-ink-dark">
      <main class="mx-auto max-w-[46rem] px-4 py-10 text-[16px] leading-relaxed sm:px-6">
        <header class="mb-8">
          <p class="kicker">Unlisted</p>
          <h1 class="mt-1 text-3xl font-semibold">Research interview prep</h1>
          <p class="mt-3">Questions with short points, not scripted answers. Say each answer aloud, then open the points to see what you missed. Built for the Microsoft Research undergraduate internship, and most of it carries over to other research interviews.</p>
          <p class="mt-3 text-sm text-ink-muted">Questions come from interview reports and your own papers and notes. Items marked as a prediction or inference are guesses. Updated November 5, 2026.</p>
        </header>

        <nav class="no-print mb-8 flex flex-wrap items-center gap-x-4 gap-y-1 border-y border-border-paper py-3 text-sm" aria-label="Sections">
          {nav.map(([id, title]) => <a href={`#${id}`}>{title}</a>)}
          <button id="toggle-all" type="button" class="ml-auto border border-border-paper px-3 py-1 text-ink-dark">Open all</button>
        </nav>

        <section class="mb-10">
          <p class="kicker">What people report</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">What to expect</h2>
          <p class="mb-3 text-sm text-ink-muted">Self-reported and uneven. Microsoft does not describe the format or dates.</p>
          {expect.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
        </section>

        <section class="mb-10">
          <p class="kicker">A judgment call, not from a report</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">What transfers</h2>
          {transfers.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
        </section>

        <section id="who" class="mb-10 scroll-mt-4">
          <p class="kicker">A judgment call, not from a report</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Who is asking</h2>
          <p class="mb-3 text-sm text-ink-muted">Look up each interviewer first. Lead with the work closest to theirs, then connect it to your main question.</p>
          {audiences.map(([label, text]) => <div class="row"><span>{label}</span><span>{linkParts(text).map((part, i) => i % 2 ? <a href="#matplotlib">{part}</a> : part)}</span></div>)}
        </section>

        <section id="matplotlib" class="mb-10 scroll-mt-4">
          <p class="kicker">Gemma paper, one patch</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">The matplotlib example</h2>
          <p class="mb-3">Gemma fixed the reported bug, broke something next to it, then gave its patch a perfect score. Its reasoning covers only the reported bug.</p>

          <div class="row"><span>The report</span><span><a href="https://github.com/matplotlib/matplotlib/issues/24386" {...external}>Issue 24386</a> says <code>top</code> and <code>bottom</code> are reversed in <code>HPacker</code>, the class that lays boxes out in a row.</span></div>
          <div class="row"><span>The catch</span><span><code>VPacker</code> stacks boxes in a column and calls the same helper for <code>left</code> and <code>right</code>. Those two already worked, so a correct fix has to leave them alone.</span></div>
          <div class="row"><span>The patch</span><span>Gemma swapped the two branches of the helper whole. Offset 0 is the near edge, the left or the bottom.</span></div>
          <pre class="my-3" set:text={matplotlibDiff} />
          {matplotlibPairings.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
          <div class="row"><span>Gemma's own check</span><span>While writing the patch, Gemma's script tried only <code>bottom</code> and <code>top</code> in <code>HPacker</code>.</span></div>
          <div class="row"><span>Gemma as judge</span><span>Asked for the chance the hidden tests pass, without being told who wrote the patch, Gemma answered 100. It called the change "a simple swap" that "correctly implements the expected behavior". Its reasoning covers only top and bottom, and both coders marked the defect as not named.</span></div>
          <div class="row"><span>The test result</span><span>The test added by the <a href="https://github.com/matplotlib/matplotlib/pull/24570" {...external}>upstream fix</a> checks six alignments. <code>left</code> and <code>right</code> fail, and the other four pass.</span></div>
          <div class="row"><span>GLM-4.5 as judge</span><span>GLM-4.5 scored it 20: the patch "breaks VPacker by reversing left and right". That is the contrast the paper opens with.</span></div>
          <div class="row"><span>Other writers</span><span>GLM-4.5, Kimi-K2 and Qwen3-Coder each wrote the correct pairing and pass. Gemma scored all three 100, the same as its own failing patch. It scored Llama-4-Maverick's failing patch 0, so it does not give everything 100.</span></div>
          <div class="row"><span>Gemma with a shell</span><span>Gemma first suspected the patch also fixed <code>VPacker</code>, then wrote a test for it. The test failed, and Gemma dropped its score to 20.</span></div>
          <div class="row"><span>Repository tests</span><span>The patch passes this check. All 263 stable existing tests still pass, so the check does not hold it back and it never gets a repair run.</span></div>

          <h3 class="mb-2 mt-6 text-base font-semibold text-ink-blue">All nine judges, same patch</h3>
          <div class="scores">{matplotlibScores.map(([judge, score]) => <><span>{judge}</span><span>{score}</span></>)}</div>
          <p class="mt-2 text-sm text-ink-muted">The eight outside judges average 67, so Gemma's leniency on this patch is about +33.</p>

          <h3 class="mb-2 mt-6 text-base font-semibold text-ink-blue">Telling it in 20 seconds</h3>
          <ul class="ml-5 list-disc space-y-1">{matplotlibTelling.map((point) => <li>{point}</li>)}</ul>

          <h3 class="mb-2 mt-6 text-base font-semibold text-ink-blue">Where it can be challenged</h3>
          <ul class="ml-5 list-disc space-y-1">{matplotlibChallenges.map((point) => <li>{point}</li>)}</ul>
        </section>

        {sections.map((section) => (
          <section id={section.id} class="mb-10 scroll-mt-4">
            <p class="kicker">{section.kicker}</p>
            <h2 class="mb-3 mt-1 text-xl font-semibold">{section.title}</h2>
            {section.note && <p class="mb-3 text-sm text-ink-muted">{section.note}</p>}
            {section.groups.map((group) => (
              <div class="mb-6">
                {group.title && <h3 class="mb-2 mt-5 text-base font-semibold text-ink-blue">{group.title}</h3>}
                {group.items.map((item) => (
                  <details>
                    <summary>{item.q}</summary>
                    <ul>{item.points.map((point) => <li>{linkParts(point).map((part, i) => i % 2 ? <a href="#matplotlib">{part}</a> : part)}</li>)}</ul>
                  </details>
                ))}
              </div>
            ))}
          </section>
        ))}

        <section id="design" class="mb-10 scroll-mt-4">
          <p class="kicker">About 10 minutes, said aloud</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Open-ended design</h2>
          <p class="mb-3 text-sm text-ink-muted">Only one such prompt is reported for this program. This structure is a working guess. If you blank, go back to choosing a metric.</p>
          {designSteps.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
          <h3 class="mb-2 mt-6 text-base font-semibold text-ink-blue">Practice prompts</h3>
          <ul class="ml-5 list-disc space-y-1">{designPrompts.map((prompt) => <li>{prompt}</li>)}</ul>
        </section>

        <section id="basics" class="mb-10 scroll-mt-4">
          <p class="kicker">Light review</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Basics</h2>
          {basics.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
        </section>

        <section id="labs" class="mb-10 scroll-mt-4">
          <p class="kicker">Inferred from each group's work</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">By lab</h2>
          <p class="mb-3 text-sm text-ink-muted">No report lists these. Read a paper before saying anything about it.</p>
          {labs.map(([label, text]) => <div class="row"><span>{label}</span><span>{text}</span></div>)}
        </section>

        <section id="ask" class="mb-10 scroll-mt-4">
          <p class="kicker">End of the interview</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Ask them</h2>
          <ul class="ml-5 list-disc space-y-1">{askThem.map((question) => <li>{question}</li>)}</ul>
        </section>

        <section id="checks" class="mb-10 scroll-mt-4">
          <p class="kicker">Before the interview</p>
          <h2 class="mb-3 mt-1 text-xl font-semibold">Still to check</h2>
          <ul class="ml-5 list-disc space-y-1">{checks.map((check) => <li>{check}</li>)}</ul>
        </section>

        <footer class="border-t border-border-paper pt-4 text-sm text-ink-muted">
          <p class="kicker mb-2">Sources</p>
          <ul class="space-y-1">{sources.map(([label, href]) => <li><a href={href} {...external}>{label}</a></li>)}</ul>
        </footer>
      </main>
    </div>
    <script is:inline>
      const toggle = document.getElementById('toggle-all');
      toggle.addEventListener('click', () => {
        const open = toggle.textContent === 'Open all';
        document.querySelectorAll('.prep details').forEach((d) => { d.open = open; });
        toggle.textContent = open ? 'Close all' : 'Open all';
      });
    </script>
  </body>
</html>
