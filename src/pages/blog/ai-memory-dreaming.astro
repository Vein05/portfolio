  <p>Written from primary sources read on 8 October 2026: product docs, launch posts, and Honcho's source code. The store in section II is invented to show the operations; each operation comes from the sources below.</p>
  <ul>
    <li>Honcho source code: <a href="https://github.com/plastic-labs/honcho">github.com/plastic-labs/honcho</a> (deriver prompts, dreamer specialists, dream trigger, config); evaluations at <a href="https://honcho.dev/evals/">honcho.dev/evals</a></li>
    <li>OpenAI: the <a href="https://openai.com/index/chatgpt-memory-dreaming/">dreaming post</a> and the <a href="https://help.openai.com/en/articles/8590148-memory-faq">Memory FAQ</a></li>
    <li>Anthropic: the <a href="https://claude.com/resources/articles/new-in-claude-managed-agents">launch post</a>, and the <a href="https://platform.claude.com/docs/en/managed-agents/dreams">Dreams</a> and <a href="https://platform.claude.com/docs/en/managed-agents/memory">Memory stores</a> docs</li>
    <li>Devin: the <a href="https://docs.devin.ai/product-guides/memory">Memory and Dreaming docs</a> and the <a href="https://devin.ai/blog/memory-and-dreaming">blog post</a></li>
    <li>OpenClaw: <a href="https://docs.openclaw.ai/concepts/dreaming">Dreaming</a></li>
    <li>Letta: <a href="https://docs.letta.com/guides/agents/architectures/sleeptime">Dreaming (sleep-time)</a></li>
    <li>Papers: <a href="https://arxiv.org/abs/2605.12978">Zhang et al. 2605.12978</a>, <a href="https://arxiv.org/abs/2609.36457">LAPSE 2609.36457</a>, <a href="https://arxiv.org/abs/2608.01679">AuthMem-Bench 2608.01679</a></li>
  </ul>
</footer>

<script is:inline>
(function () {
  // ---------- theme: day = light page, night = dark page; one switch for both ----------
  var root = document.documentElement;

  // ---------- hero: a plaque on each painted cloud, one per session ----------
  var NS = 'http://www.w3.org/2000/svg';
  var cloudsG = document.getElementById('clouds');
  // painting coordinates (1961 x 802); the last cloud is the one above the standing figure
  var spots = [[1130,320],[1280,140],[1520,300],[1690,74],[1860,240],[1190,522]];
  var TODAY = spots.length - 1;
  var clouds = spots.map(function (p, i) {
    var g = document.createElementNS(NS, 'g');
    g.setAttribute('class', 'cloud' + (i === TODAY ? ' today' : ''));
    g.dataset.x = p[0]; g.dataset.y = p[1];
    g.style.transform = 'translate(' + p[0] + 'px,' + p[1] + 'px)';
    var label = i === TODAY ? 'today\u2019s session' : 'session ' + (i + 1);
    var w = i === TODAY ? 190 : 124;
    var r = document.createElementNS(NS, 'rect');
    r.setAttribute('x', -w / 2); r.setAttribute('y', -20); r.setAttribute('width', w); r.setAttribute('height', 36); r.setAttribute('rx', 18);
    var t = document.createElementNS(NS, 'text');
    t.setAttribute('x', 0); t.setAttribute('y', 7); t.setAttribute('text-anchor', 'middle');
    t.textContent = label;
    g.appendChild(r); g.appendChild(t);
    cloudsG.appendChild(g);
    return g;
  });
  function dayLook() { clouds.forEach(function (c, i) { c.style.opacity = i === TODAY ? 1 : .6; }); }
  dayLook();

  var hero = document.getElementById('hero');
  var legend = document.getElementById('skyLegend');
  var night = false;
  var nightBtn = document.getElementById('nightBtn');
  function setNight(on, save) {
    night = on;
    root.setAttribute('data-theme', night ? 'dark' : 'light');
    if (save) { try { localStorage.setItem('somnium-theme', night ? 'dark' : 'light'); } catch (e) {} }
    hero.classList.toggle('night', night);
    nightBtn.textContent = night ? 'Let the day return' : 'Let the sky turn to night';
    clouds.forEach(function (c, i) {
      if (night) {
        // every session drifts to the temple: the dreamer reads them together, against the store
        var tx = 1500 + (i % 3) * 130, ty = 300 + Math.floor(i / 3) * 44;
        c.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(.8)';
        c.style.opacity = 1;
      } else {
        c.style.transform = 'translate(' + c.dataset.x + 'px,' + c.dataset.y + 'px)';
      }
    });
    if (!night) dayLook();
    legend.hidden = !night;
    legend.textContent = 'At night the user is gone. The dreamer gathers every session at once and reads them against the temple: it merges, replaces, deletes, and adds what no single session said.';
  }
  nightBtn.addEventListener('click', function () { setNight(!night, true); });
  document.getElementById('themeBtn').addEventListener('click', function () { setNight(!night, true); });
  // the page opens in daylight unless the reader chose night before
  var saved = null;
  try { saved = localStorage.getItem('somnium-theme'); } catch (e) {}
  setNight(saved === 'dark', false);

  // ---------- temple plaques: one under each column (painting coordinates) ----------
  var colX = [184, 456, 684, 940, 1222, 1476];
  var labels = [
    ['asked for', 'Python', 'explicit, s2'], ['asked for Python', 'again', 'explicit, s7'], ['writes tests', 'in pytest', 'explicit, s9'],
    ['works as', 'a nurse', 'explicit, s4'], ['meeting is', 'on Tuesday', 'soft-deleted, s3'], ['moved meeting', 'to Thursday', 'explicit, s6']
  ];
  var plq = document.getElementById('plaques');
  colX.forEach(function (x, i) {
    [[labels[i][0], 'lbl', 30, 820], [labels[i][1], 'lbl', 30, 856], [labels[i][2], 'lbl-i', 25, 894]].forEach(function (d) {
      var t = document.createElementNS(NS, 'text');
      t.setAttribute('x', x); t.setAttribute('y', d[3]); t.setAttribute('text-anchor', 'middle');
      t.setAttribute('class', d[1]); t.setAttribute('font-size', d[2]); t.textContent = d[0];
      plq.appendChild(t);
    });
  });

  // ---------- simulator ----------
  var initial = [
    { id: 'a', k: 'explicit', t: 'Ana lives in Lisbon', s: 'session 1' },
    { id: 'b', k: 'explicit', t: 'Ana lives in Lisbon, Portugal', s: 'session 3' },
    { id: 'c', k: 'explicit', t: "Ana's meeting is on Tuesday", s: 'session 3' },
    { id: 'd', k: 'explicit', t: 'Ana moved the meeting to Thursday', s: 'session 6' },
    { id: 'e', k: 'explicit', t: 'Ana works as a nurse', s: 'session 4' },
    { id: 'f', k: 'explicit', t: 'Ana asked for the code in Python', s: 'session 2' },
    { id: 'g', k: 'explicit', t: 'Ana asked for Python again', s: 'session 7' },
    { id: 'h', k: 'explicit', t: 'Ana is driving a rental car this week', s: 'session 5' },
    { id: 'i', k: 'explicit', t: 'Ana is allergic to penicillin', s: 'session 1, never read' }
  ];
  var box = document.getElementById('tablets');
  var step = 0;
  function render() {
    box.innerHTML = '<div class="caps sim-label" style="margin-bottom:10px">The store</div>';
    initial.forEach(function (x) { box.appendChild(make(x)); });
  }
  function make(x) {
    var d = document.createElement('div');
    d.className = 'tablet ' + x.k; d.id = 't-' + x.id;
    d.innerHTML = '<div class="txt"><span class="badge">' + x.k.toUpperCase() + '</span>' + x.t + '</div><div class="src">' + x.s + '</div>';
    return d;
  }
  function addAfter(refId, x) {
    var el = make(x); el.classList.add('flash');
    var ref = document.getElementById('t-' + refId);
    ref.parentNode.insertBefore(el, ref.nextSibling);
    setTimeout(function () { el.classList.remove('flash'); }, 1400);
  }
  var steps = [
    function () {
      var a = document.getElementById('t-a');
      a.querySelector('.txt').lastChild.textContent = 'Ana lives in Lisbon, Portugal';
      a.querySelector('.src').textContent = 'merged from sessions 1, 3';
      a.classList.add('flash'); setTimeout(function () { a.classList.remove('flash'); }, 1400);
      document.getElementById('t-b').classList.add('gone');
    },
    function () {
      document.getElementById('t-c').classList.add('struck');
      document.getElementById('t-c').querySelector('.src').textContent = 'session 3, soft-deleted';
      addAfter('d', { id: 'd2', k: 'deductive', t: "Ana's meeting is on Thursday", s: 'updated from sessions 3, 6' });
    },
    function () {
      addAfter('e', { id: 'e2', k: 'deductive', t: 'Ana works in healthcare', s: 'from session 4, never said' });
    },
    function () {
      addAfter('g', { id: 'g2', k: 'inductive', t: 'Ana prefers Python', s: 'low confidence, sessions 2, 7' });
    },
    function () {
      var h = document.getElementById('t-h');
      h.className = 'tablet risk flash';
      h.querySelector('.badge').textContent = 'REWRITTEN';
      h.querySelector('.txt').lastChild.textContent = 'Ana drives a rental car';
      h.querySelector('.src').textContent = 'session 5, "this week" lost';
      setTimeout(function () { h.classList.remove('flash'); }, 1400);
    },
    function () {
      var i = document.getElementById('t-i');
      i.className = 'tablet risk';
      i.querySelector('.badge').textContent = 'DELETED';
      setTimeout(function () { i.classList.add('gone'); }, 900);
    }
  ];
  var chron = document.querySelectorAll('#chron li');
  function doStep() {
    if (step >= steps.length) return;
    steps[step](); chron[step].classList.add('done'); step++;
  }
  document.getElementById('stepBtn').addEventListener('click', doStep);
  document.getElementById('allBtn').addEventListener('click', function () {
    (function next() { if (step < steps.length) { doStep(); setTimeout(next, 1100); } })();
  });
  document.getElementById('resetBtn').addEventListener('click', function () {
    step = 0; render(); chron.forEach(function (li) { li.classList.remove('done'); });
  });
  render();
})();
</script>
</body>
</html>
