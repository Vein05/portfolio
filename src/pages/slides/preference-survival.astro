// Preference survival talk deck, on the shared SlideDeck frame (slides/README.md).
// Public deck; the work is unpublished and the confirmatory study has not run. The
// talk ends at related work.
//
// Sources, all in research/preference-survival/:
//   DEV  = research/CHANNEL_V1_REPORT_2026-10-08.md (the 2026-10-08 development study)
//   IDEA = IDEA_CHANGELOG.md, entry of 2026-10-10 (accuracy by side at session 12)
//   HOLE = research/HOLE_CHECKS_2026-10-10.md
//   PRIOR = research/PRIOR_WORK_2026-10-10.md; abstracts re-read on arXiv 2026-10-14
import SlideDeck from '../../layouts/SlideDeck.astro';
import Slide from '../../components/slides/Slide.astro';
import PaperFigure from '../../components/slides/PaperFigure.astro';
import RelatedCards from '../../components/slides/RelatedCards.astro';
import RelatedCard from '../../components/slides/RelatedCard.astro';
import Guess from '../../components/slides/Guess.astro';

// DEV, "Q3 Growth across repeated rewriting": share of preferences still in
// memory, by rewrites since the preference was stated.
const survival = [
  { when: 'when stated', pct: 96, label: '96%' },
  { when: '1 rewrite later', pct: 77, label: '77%' },
  { when: '4 rewrites later', pct: 54, label: '54%' },
  { when: '10 or 11 later', pct: 42, label: '37 to 47%' },
];

// The six users of the default-user figure (slide "The default user"), from
// research/figures/preference-survival/html/data.js (gen_data.py over data/channel-v1):
// stated values per contrast, model defaults, and the figure's face colours. Glyphs are
// Phosphor (MIT) and the face is Material Symbols face-sharp (Apache-2.0), as in fig1-ph.js.
const userContrasts = [{"head":"prose or bullets","def":1,"sides":["pilcrow","list"]},{"head":"diagrams or text","def":1,"sides":["workflow","file-text"]},{"head":"alone or group","def":0,"sides":["user","users"]},{"head":"quiet or lively","def":0,"sides":["coffee","party-popper"]}];
const users = [{"user":4,"color":"#2b7fa0","stated":[1,1,0,0]},{"user":0,"color":"#c8901a","stated":[1,1,0,1]},{"user":3,"color":"#7b4fa6","stated":[1,0,0,1]},{"user":6,"color":"#3a8a57","stated":[1,0,1,0]},{"user":2,"color":"#3f5cc0","stated":[0,0,1,0]},{"user":15,"color":"#8a6440","stated":[0,0,1,1]}];
const glyphs = {"pilcrow":"<g transform=\"scale(0.09375)\"><path fill=\"currentColor\" d=\"M208 36H96a68 68 0 0 0 0 136h36v36a12 12 0 0 0 24 0V60h16v148a12 12 0 0 0 24 0V60h12a12 12 0 0 0 0-24m-76 112H96a44 44 0 0 1 0-88h36Z\"/></g>","list":"<g transform=\"scale(0.09375)\"><path fill=\"currentColor\" d=\"M76 64a12 12 0 0 1 12-12h128a12 12 0 0 1 0 24H88a12 12 0 0 1-12-12m140 52H88a12 12 0 0 0 0 24h128a12 12 0 0 0 0-24m0 64H88a12 12 0 0 0 0 24h128a12 12 0 0 0 0-24M44 112a16 16 0 1 0 16 16a16 16 0 0 0-16-16m0-64a16 16 0 1 0 16 16a16 16 0 0 0-16-16m0 128a16 16 0 1 0 16 16a16 16 0 0 0-16-16\"/></g>","workflow":"<g transform=\"scale(0.09375)\"><path fill=\"currentColor\" d=\"M160 116h48a20 20 0 0 0 20-20V48a20 20 0 0 0-20-20h-48a20 20 0 0 0-20 20v12h-12a28 28 0 0 0-28 28v28H76v-4a20 20 0 0 0-20-20H24a20 20 0 0 0-20 20v32a20 20 0 0 0 20 20h32a20 20 0 0 0 20-20v-4h24v28a28 28 0 0 0 28 28h12v12a20 20 0 0 0 20 20h48a20 20 0 0 0 20-20v-48a20 20 0 0 0-20-20h-48a20 20 0 0 0-20 20v12h-12a4 4 0 0 1-4-4V88a4 4 0 0 1 4-4h12v12a20 20 0 0 0 20 20M52 140H28v-24h24Zm112 24h40v40h-40Zm0-112h40v40h-40Z\"/></g>","file-text":"<g transform=\"scale(0.09375)\"><path fill=\"currentColor\" d=\"m216.49 79.52l-56-56A12 12 0 0 0 152 20H56a20 20 0 0 0-20 20v176a20 20 0 0 0 20 20h144a20 20 0 0 0 20-20V88a12 12 0 0 0-3.51-8.48M160 57l23 23h-23ZM60 212V44h76v48a12 12 0 0 0 12 12h48v108Zm112-80a12 12 0 0 1-12 12H96a12 12 0 0 1 0-24h64a12 12 0 0 1 12 12m0 40a12 12 0 0 1-12 12H96a12 12 0 0 1 0-24h64a12 12 0 0 1 12 12\"/></g>","user":"<g transform=\"scale(0.09375)\"><path fill=\"currentColor\" d=\"M234.38 210a123.36 123.36 0 0 0-60.78-53.23a76 76 0 1 0-91.2 0A123.36 123.36 0 0 0 21.62 210a12 12 0 1 0 20.77 12c18.12-31.32 50.12-50 85.61-50s67.49 18.69 85.61 50a12 12 0 0 0 20.77-12M76 96a52 52 0 1 1 52 52a52.06 52.06 0 0 1-52-52\"/></g>","users":"<g transform=\"scale(0.09375)\"><path fill=\"currentColor\" d=\"M164.38 181.1a52 52 0 1 0-72.76 0a75.9 75.9 0 0 0-30 28.89a12 12 0 0 0 20.78 12a53 53 0 0 1 91.22 0a12 12 0 1 0 20.78-12a75.9 75.9 0 0 0-30.02-28.89M100 144a28 28 0 1 1 28 28a28 28 0 0 1-28-28m147.21 9.59a12 12 0 0 1-16.81-2.39c-8.33-11.09-19.85-19.59-29.33-21.64a12 12 0 0 1-1.82-22.91a20 20 0 1 0-24.78-28.3a12 12 0 1 1-21-11.6a44 44 0 1 1 73.28 48.35a92.2 92.2 0 0 1 22.85 21.69a12 12 0 0 1-2.39 16.8m-192.28-24c-9.48 2.05-21 10.55-29.33 21.65a12 12 0 0 1-19.19-14.45a92.4 92.4 0 0 1 22.85-21.69a44 44 0 1 1 73.28-48.35a12 12 0 1 1-21 11.6a20 20 0 1 0-24.78 28.3a12 12 0 0 1-1.82 22.91Z\"/></g>","coffee":"<g transform=\"scale(0.09375)\"><path fill=\"currentColor\" d=\"M212 76H32a12 12 0 0 0-12 12v48a100.24 100.24 0 0 0 26.73 68H32a12 12 0 0 0 0 24h176a12 12 0 0 0 0-24h-14.73a100.8 100.8 0 0 0 20-32A44 44 0 0 0 256 128v-8a44.05 44.05 0 0 0-44-44m-16 60a76.27 76.27 0 0 1-42 68H86a76.27 76.27 0 0 1-42-68v-36h152Zm36-8a20 20 0 0 1-12.57 18.55A97 97 0 0 0 220 136v-34.32A20 20 0 0 1 232 120ZM68 48V24a12 12 0 0 1 24 0v24a12 12 0 0 1-24 0m40 0V24a12 12 0 0 1 24 0v24a12 12 0 0 1-24 0m40 0V24a12 12 0 0 1 24 0v24a12 12 0 0 1-24 0\"/></g>","party-popper":"<g transform=\"scale(0.09375)\"><path fill=\"currentColor\" d=\"M114.32 49.8a19.79 19.79 0 0 0-32.6 7.2l-52.5 144.41A19.82 19.82 0 0 0 47.75 228a20 20 0 0 0 6.84-1.22L199 174.28a19.79 19.79 0 0 0 7.24-32.6Zm-10.13 133.41l-31.4-31.4l10.15-27.91l49.16 49.16Zm-40.42-6.51l15.53 15.56l-24.45 8.89ZM157 164L92 99l10-27.58L184.57 154ZM128 40V16a12 12 0 0 1 24 0v24a12 12 0 0 1-24 0m116.48 83.51a12 12 0 0 1-17 17l-16-16a12 12 0 0 1 17-17Zm-.69-40.13l-24 8a12 12 0 0 1-7.59-22.77l24-8a12 12 0 1 1 7.59 22.77M156.6 65.93C159.83 47.47 173.39 36 192 36c6.45 0 8.69-2.49 10-4.92a18 18 0 0 0 2-7.22V24a12 12 0 0 1 24 0c0 14.47-9.59 36-36 36c-4.94 0-10.21 1.19-11.76 10.06A12 12 0 0 1 168.43 80a12.4 12.4 0 0 1-2.08-.18a12 12 0 0 1-9.75-13.89\"/></g>"};
const face = "<path fill=\"currentColor\" d=\"M8.113 13.888Q7.75 13.525 7.75 13t.363-.888T9 11.75t.888.363t.362.887t-.363.888T9 14.25t-.888-.363m6 0q-.362-.362-.362-.887t.363-.888t.887-.362t.888.363t.362.887t-.363.888t-.887.362t-.888-.363M12 20q3.35 0 5.675-2.325T20 12q0-.6-.075-1.162T19.65 9.75q-.525.125-1.05.188T17.5 10q-2.275 0-4.3-.975T9.75 6.3q-.8 1.95-2.287 3.388T4 11.85V12q0 3.35 2.325 5.675T12 20m0 2q-2.075 0-3.9-.787t-3.175-2.138T2.788 15.9T2 12t.788-3.9t2.137-3.175T8.1 2.788T12 2t3.9.788t3.175 2.137T21.213 8.1T22 12t-.788 3.9t-2.137 3.175t-3.175 2.138T12 22\"/>";
---

<SlideDeck
  title="Preference Survival: Slides from AIMS Lab"
  description="Talk slides: memory forgets preferences evenly, but models fill the gaps with the same default, so users who differ lose out."
  canonical="https://spanthi.com/slides/preference-survival/"
  ogImage="https://spanthi.com/slides/preference-survival/og.png"
>
  <!-- 1. Title -->
  <Slide label="Title" variant="title" kicker="Preference survival" title="Memory forgets preferences evenly, but serves only the default user">
    <p class="lede">When memory forgets a preference, the model falls back on its usual answer, its default. Early results from a development study.</p>
    <div class="byline">
      <div>AIMS Lab</div>
      <div class="muted">University of Southern Mississippi</div>
    </div>
  </Slide>

  <!-- 2. Homogenization. Claims from the arXiv abstracts (PRIOR, Q4 and Q5). -->
  <Slide label="Homogenization" kicker="01 Homogenization" title="Language models make answers, writing and outcomes more alike">
    <div class="trio">
      <div class="trio-item">
        <div class="label">Across models</div>
        <p>Different models give strikingly similar answers.</p>
        <div class="cite">Jiang et al., NeurIPS 2025</div>
      </div>
      <div class="trio-item">
        <div class="label">Across writers</div>
        <p>Essays written with InstructGPT are more alike.</p>
        <div class="cite">Padmakumar and He, ICLR 2024</div>
      </div>
      <div class="trio-item">
        <div class="label">Across systems</div>
        <p>Systems that share data fail the same people.</p>
        <div class="cite">Bommasani et al., NeurIPS 2022</div>
      </div>
    </div>
  </Slide>

  <!-- 2b. The users, so the default-user figure's cast is known before it appears.
       Data: userContrasts and users above. A chip is red when the stated value is not
       the models' default. -->
  <Slide label="The users" kicker="02 The problem" title="Some users want what the model assumes, and some do not">
    <div class="users">
      <div></div>
      {userContrasts.map((c) => <div class="u-head">{c.head}</div>)}
      <div></div>
      {users.map((u) => {
        const n = u.stated.filter((v, k) => v !== userContrasts[k].def).length;
        return (
          <Fragment>
            <svg class="u-face" viewBox="0 0 24 24" style={`color:${u.color}`} aria-hidden="true" set:html={face} />
            {u.stated.map((v, k) => (
              <div class:list={['u-chip', v === userContrasts[k].def ? 'def' : 'oth']}>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={glyphs[userContrasts[k].sides[v]]} />
              </div>
            ))}
            <div class="u-count">{n === 0 ? 'matches all 4' : `${n} of 4 differ`}</div>
          </Fragment>
        );
      })}
    </div>
    <p class="foot">Six of 36 users from the development study. Red: not what models assume.</p>
  </Slide>

  <!-- 3. The problem, one concrete case. Made-up example; the defaults match
       the shared defaults in DEV ("bulleted lists"). -->
  <Slide label="The problem" kicker="02 The problem" title="A forgotten preference becomes the model's usual answer">
    <div class="case">
      <div class="case-head"></div>
      <div class="case-head">The user says</div>
      <div class="case-head" data-step="1">Memory, session 12</div>
      <div class="case-head" data-step="2">The answer</div>

      <div class="case-user">User A</div>
      <div class="case-cell">“Please write in paragraphs, not bullet points.”</div>
      <div class="case-cell muted" data-step="1">nothing about format</div>
      <div class="case-cell" data-step="2"><span class="red">bullet points</span>, wrong</div>

      <div class="case-user">User B</div>
      <div class="case-cell">“Bullet points, please.”</div>
      <div class="case-cell muted" data-step="1">nothing about format</div>
      <div class="case-cell" data-step="2"><span class="blue">bullet points</span>, right</div>
    </div>
    <p class="foot" data-step="3">
      Made-up example. The model's usual choice is its <strong>default</strong>. It is right only for User B.
    </p>
  </Slide>

  <!-- 4. Mechanism. Step 1: DEV "Q2" (no writer direction); step 2: DEV "Q4"
       decomposition; step 3: DEV "Instrument checks" (shared defaults). -->
  <Slide label="How it happens" kicker="03 How it happens" title="Three steps turn even forgetting into uneven outcomes">
    <ol class="steps">
      <li data-step="1"><span class="step-n">1</span>A writer model rewrites memory and drops preferences evenly.</li>
      <li data-step="2"><span class="step-n">2</span>A reader model fills each gap with its default.</li>
      <li data-step="3"><span class="step-n">3</span>Models from different labs share the same defaults.</li>
    </ol>
    <p class="foot" data-step="3">Shared defaults so far: plain wording, brief answers, bullet lists, a serious tone.</p>
  </Slide>

  <!-- 5. Main result, guess first. IDEA, 2026-10-10 table: 93% matching,
       50% opposing, both readers, session 12; full history 100% (DEV,
       "Instrument checks": 432/432). -->
  <Slide label="Main result" kicker="04 Early result" title="Users who differ from the default fall to a coin flip" titleStep={1}>
    <Guess question="After 12 sessions, how often is a preference against the default answered correctly?">
      <div class="numbers">
        <div><span class="num blue">93%</span><span class="gloss">matches the default</span></div>
        <div><span class="num red">50%</span><span class="gloss">against the default</span></div>
        <div><span class="num">100%</span><span class="gloss">either kind, from the full chat history</span></div>
      </div>
    </Guess>
    <p class="foot">Development study, 2026-10-08: 36 synthetic users, two reader models.</p>
  </Slide>

  <!-- 5b. The default-user figure, approved demo of 2026-10-11:
       research/figures/preference-survival/build/fig1-demo-sharp.png, data from
       html/data.js (gen_data.py over data/channel-v1). Rows: six of 36 users chosen by
       stated profile; GLM writer, summary policy; DeepSeek reader; session 12. Five rows
       end identical to the default user (html/story.md). 93% and 50% pool all 12 systems. -->
  <Slide label="The default user" kicker="04 Early result" title="Five of six example users end up answered as the default user">
    <PaperFigure
      fill
      src="/slides/preference-survival/default-user.webp"
      alt="Six users state preferences in sessions 1 to 4; red marks a preference that differs from the model's default. By session 12 memory keeps only three of 24 preferences. The reader answers the rest with its default, so five of the six users get the same answers as one default user: bullets, text, alone, quiet. Pooled over all 12 memory systems, 93% of preferences that match the default are answered right, and 50% of those that differ."
    />
    <p class="foot">Demo from the development study: six of 36 users, GLM writer, DeepSeek reader. Percentages pool all 12 memory systems.</p>
  </Slide>

  <!-- 6. Not the writer. Bars: DEV "Q3". Writer gap: DEV "Q2" table
       (+0.3, -4.1, -1.1 points; largest 4.1). 87%: DEV "Q4", DeepSeek reader, session 12,
       dropped preferences, real memory. -->
  <Slide label="Where the bias comes from" kicker="05 Where the bias comes from" title="Writers forget both sides equally; the reader adds the bias">
    <div class="split">
      <div>
        <div class="label">A preference is still in memory</div>
        <div class="bars">
          {survival.map((s) => (
            <div class="bar-row">
              <div class="bar-when">{s.when}</div>
              <div class="bar-track"><div class="bar-fill" style={`width:${s.pct}%`}></div></div>
              <div class="bar-val">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
      <div class="facts">
        <div class="fact"><span class="num">4 points</span><span class="gloss">at most between what writers keep on each side of the default</span></div>
        <div class="fact"><span class="num red">87%</span><span class="gloss">of the preferences memory dropped were answered with the default</span></div>
      </div>
    </div>
    <p class="foot">Development study, three writer families. The 87% is one reader at session 12.</p>
  </Slide>

  <!-- 7. Shared failures. DEV "Q5": every user-preference failed by >= 10 of
       12 systems opposes the reader default (100%, both readers; 3.0% of
       user-preferences, DeepSeek reader). 12 systems = 3 writers x 4 policies. HOLE,
       section 1: about 70 to 75% of the overlap is contrast plus side. -->
  <Slide label="Shared failures" kicker="06 Shared failures" title="Switching memory systems does not help users who differ">
    <div class="big">
      <span class="num red">100%</span>
      <p>of the preferences that nearly every memory setup got wrong belonged to users who differ from the default.</p>
    </div>
    <p class="foot">Wrong in at least 10 of 12 setups: 3 writer models times 4 memory formats. The reason is that all setups drop the same kinds of preferences.</p>
  </Slide>

  <!-- 8. Limits of the early results. DEV, header and "Q4" (+2.4 to +4.6
       points excess over erasure at session 12), "Budget drift". -->
  <Slide label="Limits" kicker="07 What this does not show yet" title="The early results are small, synthetic and judged by a model">
    <ul class="limits">
      <li>36 made-up users and three model families.</li>
      <li>Labels come from a model judge, not from people.</li>
      <li>Random forgetting explains most of the effect; memory adds 2 to 5 points.</li>
      <li>Writers go over the length limit, so equal-length comparisons are rough.</li>
    </ul>
  </Slide>

  <!-- 9. Related work. Summaries from the arXiv abstracts (PRIOR, Q1, Q2, Q4). -->
  <Slide label="Related work" kicker="08 Related work" title="Prior work finds homogenization, but not memory drifting to defaults">
    <RelatedCards>
      <RelatedCard
        badge="arXiv 2026"
        plainBadge
        title="PRISK"
        cite="Wang et al., 2026"
        summary="Personal memories make models more sycophantic."
        difference="They use memory once. We rewrite it 12 times."
        result="Across 13 LLMs, user profiles and retrieved memories made all three biases worse: irrelevant personalization, preference narrowing and sycophancy."
        figure="/slides/preference-survival/related/prisk-fig4.webp"
        figureAlt="Figure 4 of Wang et al.: personalization risk against usefulness for Claude, Gemini, GPT, Llama and Qwen on irrelevant personalization, sycophantic bias and preference narrowing; points with a profile, retrieval, or both sit higher in risk than the no-personalization points."
        source="Wang et al., arXiv 2608.28833, abstract and Figure 4."
      />
      <RelatedCard
        badge="arXiv 2026"
        plainBadge
        title="Personalize-then-Store"
        cite="In et al., 2026"
        summary="Memory should learn what each user needs stored."
        difference="They skip passing chats. We skip what models guess."
        result="Storing per user helps retention a lot when the system knows which sessions to skip. Knowing which to skip is still unsolved."
        figure="/slides/preference-survival/related/permem-fig1.webp"
        figureAlt="Figure 1 of In et al.: Alice and Bob use an agent for different domains; a one-size-fits-all memory system evicts memories each of them needs, while a personalized memory system keeps each user's important memories and evicts their transient ones."
        source="In et al., arXiv 2605.25535, abstract and Figure 1."
      />
      <RelatedCard
        badge="NeurIPS 2022"
        title="Picking on the Same Person"
        cite="Bommasani et al., 2022"
        summary="Shared parts make systems fail the same people."
        difference="They test fairness data. We test assistant memory."
        result="Sharing training data reliably made outcomes more alike, and more so for individuals than for groups."
        figure="/slides/preference-survival/related/bommasani-fig2.webp"
        figureAlt="Figure 2 of Bommasani et al.: outcome homogenization on ACS PUMS with logistic regression as training data grows, for models trained on fixed (shared) versus disjoint data, at the individual level (left) and for racial groups (right)."
        source="Bommasani et al., arXiv 2211.13972, abstract and Figure 2."
      />
    </RelatedCards>
  </Slide>

  <!-- 10. Thanks -->
  <Slide label="Thank you" variant="title" kicker="Preference survival" title="Thank you">
    <p class="lede">Questions?</p>
    <div class="byline">
      <div>AIMS Lab</div>
      <div class="muted">spanthi.com</div>
    </div>
  </Slide>
</SlideDeck>

<style is:global>
  /* Color meaning for this deck: blue = right for the user, red = wrong or lost. */

  /* Homogenization */
  .trio { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; flex: 1; align-content: center; }
  .trio-item {
    padding: 32px 32px 28px; background: rgb(var(--color-paper-surface));
    border: 1.5px solid rgb(var(--color-border-paper));
    display: flex; flex-direction: column; gap: 16px;
  }
  .trio-item p { font-size: 32px; line-height: 1.3; }
  .trio-item .cite { font-size: 20px; color: rgb(var(--color-ink-muted)); }

  /* The problem */
  /* Users (slide 2b): chips and faces in the default-user figure's colours */
.users { margin: auto 0; display: grid; grid-template-columns: 72px repeat(4, 170px) 1fr; gap: 14px 20px; align-items: center; justify-items: center; }
.u-head { font-family: 'Oswald', sans-serif; font-size: 20px; letter-spacing: 0.08em; text-transform: uppercase; color: rgb(var(--color-ink-muted)); }
.u-face { width: 64px; height: 64px; }
.u-chip { width: 64px; height: 64px; display: grid; place-items: center; border: 2px solid; }
.u-chip svg { width: 38px; height: 38px; }
.u-chip.def { background: #e8ecf1; border-color: #5d6978; color: #5d6978; }
.u-chip.oth { background: #e5625f; border-color: #bf3b37; color: #fff; }
.u-count { justify-self: start; font-size: 26px; color: rgb(var(--color-ink-muted)); }
.case { margin: auto 0; display: grid; grid-template-columns: 170px 1.3fr 1fr 1fr; column-gap: 28px; row-gap: 20px; align-items: center; margin-top: 12px; }
  .case-head {
    font-family: 'Oswald', monospace; font-size: 18px; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgb(var(--color-ink-muted));
  }
  .case-user { font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 32px; }
  .case-cell {
    padding: 22px 26px; background: #fff; border: 1.5px solid rgb(var(--color-border-paper));
    font-size: 28px; line-height: 1.3; min-height: 112px; display: flex; align-items: center;
  }

  /* How it happens */
  .steps { list-style: none; margin: auto 0; padding: 0; display: flex; flex-direction: column; gap: 28px; }
  .steps li { display: grid; grid-template-columns: 72px 1fr; align-items: center; font-size: 38px; line-height: 1.3; }
  .step-n {
    width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    background: rgb(var(--color-ink-blue)); color: #fff; font-family: 'Oswald', sans-serif; font-size: 28px;
  }

  /* Number cards */
  .numbers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .numbers > div, .fact { display: flex; flex-direction: column; gap: 8px; }
  .deck .num { font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 72px; line-height: 1; }
  .deck .gloss { font-size: 24px; line-height: 1.35; color: rgb(var(--color-ink-muted)); }
  .guess { margin-top: 8px; }

  /* Where the bias comes from */
