  }
  .sp-plan-head {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 17pt;
    font-weight: 600;
    color: rgb(var(--color-sp-current));
    margin-bottom: 3mm;
  }
</style>
