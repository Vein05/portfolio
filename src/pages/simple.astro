---
import BaseLayout from '../layouts/BaseLayout.astro';
import { papers } from '../components/Papers.jsx';
import { experiences } from '../components/Experience.jsx';
import { items as projects } from '../components/Projects.jsx';
import { honors } from '../components/Honors.jsx';
import { skillGroups } from '../components/Skills.jsx';
import { citations } from '../data/citations.js';
import ResearchRange from '../components/ResearchRange.jsx';

// venue from tag ("Research Paper · EMNLP Findings 2026" → "EMNLP Findings 2026")
const venue = (tag: string) => tag.split('·').pop()?.trim() ?? tag;
const authorsOf = (p: { details?: string[] }) =>
  p.details?.find((d) => d.startsWith('Authors:'))?.replace('Authors: ', '') ?? 'Sugam Panthi';

// arXiv id from the paper's link, when it is an arXiv abs page
const arxivId = (link: string) => link.match(/arxiv\.org\/abs\/([\d.]+)/)?.[1] ?? null;

const lastUpdated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Sugam Panthi"
  description="Sugam Panthi — publications, experience, and projects. Plain-text research portfolio."
  canonical="https://spanthi.com/simple/"
>
  <div class="min-h-screen bg-paper-light">
    <div class="mx-auto max-w-[52rem] px-5 py-8 text-[16.5px] leading-relaxed text-ink-dark" style="font-family:'IBM Plex Sans','Oswald',sans-serif">

      <nav class="mb-8 border-b border-border-paper pb-3 text-center text-sm">
        <a href="/" class="text-ink-blue hover:underline">Full site</a>
        <span class="mx-2 text-ink-muted">/</span>
        <a href="/blog/" class="text-ink-blue hover:underline">Blog</a>
        <span class="mx-2 text-ink-muted">/</span>
        <a href="/posters/" class="text-ink-blue hover:underline">Posters</a>
        <span class="mx-2 text-ink-muted">/</span>
        <a href="/CV.pdf" class="text-ink-blue hover:underline">CV</a>
        <span class="mx-2 text-ink-muted">/</span>
        <a href="/Resume.pdf" class="text-ink-blue hover:underline">R&eacute;sum&eacute;</a>
        <span class="mx-2 text-ink-muted">/</span>
        <a href="mailto:Sugam.Panthi@usm.edu" class="text-ink-blue hover:underline">Email</a>
        <span class="mx-2 text-ink-muted">/</span>
        <a href="https://github.com/vein05" target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">GitHub</a>
        <span class="mx-2 text-ink-muted">/</span>
        <a href="https://www.linkedin.com/in/sugam-panthi" target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">LinkedIn</a>
      </nav>

      <header class="mb-10 flex items-start justify-between gap-6">
        <div class="min-w-0">
          <h1 class="text-2xl font-bold">Sugam Panthi</h1>
          <p class="mt-2 text-ink-muted">
            Co-founder @ <a href="https://magnoliaed.ai" target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">MagnoliaEd</a>
            · Research Assistant @ <a href="https://www.usm.edu/" target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">The University of Southern Mississippi</a>
          </p>
          <p class="mt-3">
            I work on LLM evaluation, tool-calling agents, and how people interact with LLMs.
            I also build software.
            This is the plain version of <a href="/" class="text-ink-blue hover:underline">spanthi.com</a>.
          </p>
          <p class="mt-3 text-sm text-ink-muted">
            B.S. Computer Science, USM Honors College, expected May 2028. Advised by <a href="https://aimsresearchlab.com" target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">Rabab
            Abdelfattah</a>. Based in Hattiesburg, MS.
          </p>
        </div>
        <img
          src="/images/headshot.jpeg"
          alt="Sugam Panthi"
          width="138"
          height="144"
          class="mt-1 h-[144px] w-[138px] shrink-0 rounded-sm border border-border-paper object-cover object-bottom"
          loading="eager"
        />
      </header>

      <section class="mb-10">
        <h2 class="mb-4 border-b border-border-paper pb-1 text-lg font-bold">Sugam&rsquo;s Research Trail <span class="text-xs font-normal text-ink-muted md:hidden">(scroll sideways...)</span></h2>
        <div class="relative left-1/2 w-[min(100vw-2.5rem,1240px)] -translate-x-1/2 pt-6">
          <ResearchRange client:load />
        </div>
      </section>

      <section class="mb-10">
        <h2 class="mb-4 border-b border-border-paper pb-1 text-lg font-bold">Education</h2>
        <p>
          <span class="font-medium">B.S. Computer Science</span>,
          <a href="https://www.usm.edu/" target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">The University of Southern Mississippi</a>,
          Honors College
          <span class="text-sm text-ink-muted"> — Aug 2024 – May 2028 (expected)</span>
        </p>
        <p class="text-sm text-ink-muted">GPA 4.0/4.0. Hattiesburg, MS.</p>
      </section>

      <section class="mb-10">
        <h2 class="mb-4 border-b border-border-paper pb-1 text-lg font-bold">Publications</h2>
        <ul class="space-y-5">
          {papers.map((p) => (
            <li>
              <a href={p.link} target="_blank" rel="noopener noreferrer" class="font-medium text-ink-blue hover:underline">{p.title}</a>
              <div class="text-sm text-ink-muted">
                {authorsOf(p)} ·
                {venue(p.tag).startsWith('arXiv') ? (
                  <span> {venue(p.tag)}</span>
                ) : (
                  <span class="bg-ink-blue/10 px-1 font-medium text-ink-dark">{venue(p.tag)}</span>
                )}
                {arxivId(p.link) ? (
                  <span> · <a href={p.link} target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">arXiv:{arxivId(p.link)}</a>
                    · <a href={`https://arxiv.org/pdf/${arxivId(p.link)}`} target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">PDF</a></span>
                ) : (
                  <span> · <a href={p.link} target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">{p.linkLabel ?? 'Read'}</a></span>
                )}
                {p.posterHref && (
                  <span> · <a href={p.posterHref} target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">Poster</a></span>
                )}
                {p.citeKey && citations[p.citeKey] && (
                  <span> · <details class="inline">
                    <summary class="inline cursor-pointer list-none text-ink-blue hover:underline [&::-webkit-details-marker]:hidden">BibTeX</summary>
                    <pre class="mt-2 overflow-x-auto border border-border-paper bg-paper-surface p-3 text-xs leading-snug text-ink-dark">{citations[p.citeKey].bibtex}</pre>
                  </details></span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="mb-10">
        <h2 class="mb-4 border-b border-border-paper pb-1 text-lg font-bold">Experience</h2>
        <ul class="space-y-3">
          {experiences.map((e) => (
            <li>
              <span class="font-medium">{e.title}</span>,
              {e.companyLink ? (
                <a href={e.companyLink} target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline"> {e.company}</a>
              ) : (
                <span> {e.company}</span>
              )}
              <span class="text-sm text-ink-muted"> — {e.period}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mb-10">
        <h2 class="mb-4 border-b border-border-paper pb-1 text-lg font-bold">Projects</h2>
        <ul class="space-y-3">
          {projects.map((p) => (
            <li>
              <a href={p.link} target="_blank" rel="noopener noreferrer" class="font-medium text-ink-blue hover:underline">{p.title}</a>
              <span class="text-ink-muted"> — {p.description}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mb-10">
        <h2 class="mb-4 border-b border-border-paper pb-1 text-lg font-bold">Honors &amp; Awards</h2>
        <ul class="space-y-2">
          {honors.map((h) => (
            <li>
              <span class="font-medium">{h.title}</span>
              <span class="text-ink-muted"> — <a href={h.link} target="_blank" rel="noopener noreferrer" class="text-ink-blue hover:underline">{h.organization}</a></span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mb-10">
        <h2 class="mb-4 border-b border-border-paper pb-1 text-lg font-bold">Service</h2>
        <ul class="space-y-2">
          <li>
            <span class="font-medium">Executive member</span>,
            <span class="text-ink-muted">GDG on Campus, The University of Southern Mississippi</span>
          </li>
        </ul>
      </section>

      <section class="mb-10">
        <h2 class="mb-4 border-b border-border-paper pb-1 text-lg font-bold">Skills</h2>
        <ul class="space-y-2">
          {skillGroups.map((g) => (
            <li>
              <span class="font-medium">{g.label}:</span>
              <span class="text-ink-muted"> {g.skills.join(', ')}</span>
            </li>
          ))}
        </ul>
      </section>

      <footer class="border-t border-border-paper pt-3 text-sm text-ink-muted">
        © Sugam Panthi · Hattiesburg, MS · <a href="/" class="text-ink-blue hover:underline">full site</a>
        · <a href="/CV.pdf" class="text-ink-blue hover:underline">CV</a>
        · <a href="/Resume.pdf" class="text-ink-blue hover:underline">résumé</a>
        <span class="block mt-1">Last updated {lastUpdated}.</span>
      </footer>
    </div>
  </div>
</BaseLayout>
